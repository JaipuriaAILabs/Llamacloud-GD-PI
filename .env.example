# LlamaCloud MCP Server Configuration

# Required: Your LlamaCloud API Key
LLAMA_CLOUD_API_KEY=your-api-key-here

# Required: Your LlamaCloud Organization ID
ORG_ID=your-org-id-here

# Optional: Project name or ID
PROJECT_NAME=Default

# Optional: Index configuration (name)
INDEX_NAME=AI-Strategy-Studies

# Optional: Index description
INDEX_DESCRIPTION=Search and retrieve information from AI Strategy Studies

# Optional: Transport type (stdio, sse, streamable-http)
TRANSPORT=streamable-http

# Optional: Port for web server (Render sets this automatically)
PORT=8000

# ============================================
# Supabase Authentication (Optional)
# ============================================
# To enable email-based access control, configure these variables.
# Leave empty/unset to disable authentication (allow all requests).

# Your Supabase project URL (e.g., https://xyz.supabase.co)
SUPABASE_URL=

# Comma-separated list of allowed email addresses
# Example: user1@example.com,user2@example.com,admin@company.com
ALLOWED_EMAILS=

# Optional: Supabase JWT secret for HS256 verification
# Leave empty to use RS256 with JWKS (recommended for production)
SUPABASE_JWT_SECRET=
